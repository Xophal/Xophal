# Xophal — Online Learning & Mock Test Platform
# Copy to .env.local and fill in values

# App (optional; defaults to http://localhost:3000)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google sign-in is opt-in and OFF by default. Leave unset/false until the Google
# OAuth provider is configured in Supabase (Authentication > Providers) and the
# client id/secret are present in this file. Set to "true" to show the
# "Continue with Google" button on the sign-in form.
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH="false"

# Google OAuth credentials (Supabase > Authentication > Providers > Google).
# Only needed when NEXT_PUBLIC_ENABLE_GOOGLE_AUTH="true".
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=""
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=""

# Extra browser origins trusted by the CSRF origin guard, comma-separated.
# Only needed if the app is reachable on additional hostnames (e.g. a www or
# apex-domain alias in front of the canonical origin). Listing a host here
# exempts it from CSRF checks, so only add origins you control.
# TRUSTED_ORIGINS="https://www.example.com"

# Supabase (fill with your project-specific values)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Supabase service role key (sensitive) — do NOT commit a real value here
SUPABASE_SERVICE_ROLE_KEY=""

# Exactly two main administrators who can approve additional admin signups
MAIN_ADMIN_EMAILS="main-admin-one@example.com,main-admin-two@example.com"

# Transactional email used for admin signup approval notifications
RESEND_API_KEY=""
RESEND_FROM="Xophal Admin <no-reply@example.com>"

# Optional: Supabase project reference used by the CLI when linking
# Example: abcdefghijklmnop12345
# If blank, the app still runs in beta preview mode but migration commands will skip remote push.
SUPABASE_PROJECT_REF=""

# Optional: set this if the CLI project ref should be read from a different variable
NEXT_PUBLIC_SUPABASE_PROJECT_REF=""

# Upstash Redis (caching & rate limiting) — leave blank in examples
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""


